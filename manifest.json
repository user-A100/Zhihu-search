{
  "manifest_version": 3,
  "name": "知藏 · 知乎收藏检索与剪藏标记",
  "version": "0.3.1",
  "description": "收藏知乎内容，一键导入 Markdown 到 Obsidian，并维护本地剪藏索引。",
  "permissions": [
    "storage",
    "tabs",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://www.zhihu.com/*",
    "https://zhuanlan.zhihu.com/*"
  ],
  "action": {
    "default_title": "打开知藏"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.zhihu.com/question/*",
        "https://zhuanlan.zhihu.com/p/*"
      ],
      "js": [
        "src/content-marker.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-clipped": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "收藏当前知乎内容并导入 Obsidian"
    }
  }
}
